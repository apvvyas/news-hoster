# Copy to .env for local development. In production set real environment variables.

# PostgreSQL connection
DATABASE_URL=postgres://news:news@localhost:5432/news_hoster
# Apply pending migrations on startup (set to false to run them manually)
DB_MIGRATIONS_RUN=true

PORT=3000
# Required in production: a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Comma-separated origins allowed to call the API from a browser (admin + websites).
# Empty = allow any origin.
CORS_ORIGINS=http://localhost:5173

# First admin account, created only when the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Sarvam AI (https://dashboard.sarvam.ai). Without a key the pipeline falls back
# to extractive clean-up and the editorial assistant is disabled.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Reasoning depth: none | low | medium | high. sarvam-105b's hidden reasoning counts
# against SARVAM_MAX_TOKENS; for rewriting, 'none' was ~6x faster and ~7x cheaper
# with equally good output in testing.
SARVAM_REASONING=none
SARVAM_MAX_TOKENS=8000

# How often the fetch + restructure pipeline runs (0 = only when triggered from the admin)
PIPELINE_INTERVAL_MINUTES=10
# Requests per minute per IP across the API
RATE_LIMIT_PER_MINUTE=600
